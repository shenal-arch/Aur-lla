{
  "name": "aur-lla",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "build": {"command":"node cloudflare/build-assets.mjs"},
  "assets": {"directory": ".worker-assets", "binding": "ASSETS", "html_handling": "none", "run_worker_first": ["/api/*", "/media/*", "/admin", "/shop", "/cart", "/checkout", "/track/*", "/product/*", "/contact", "/delivery", "/privacy"]},
  "d1_databases": [{"binding":"DB","database_name":"aurella-store","database_id":"c86a5810-a576-4057-ac44-e192667ba15f","migrations_dir":"cloudflare/migrations"}],
  "r2_buckets": [{"binding":"IMAGES","bucket_name":"aurella-product-images"}],
  "triggers": {"crons":["*/5 * * * *"]},
  "vars": {"AURELLA_PUBLIC_URL":"https://aur-lla.shenal.workers.dev"}
}

